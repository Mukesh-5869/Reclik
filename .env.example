# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
IMAGE_MODEL="gemini-2.5-flash-image"
CHECK_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CORS_ORIGIN: Comma-separated allowed frontend origins (e.g. https://boothie.vercel.app)
CORS_ORIGIN="http://localhost:3000"

# JWT_SECRET & COOKIE_SECRET: Signing keys for auth tokens and anonymous visitor cookies
JWT_SECRET="change-me-in-production"
COOKIE_SECRET="change-me-in-production"

# Seeded Super Admin & Support accounts
ADMIN_EMAIL="admin@boothie.app"
ADMIN_PASSWORD="BoothieAdmin2026!"
SUPPORT_EMAIL="support@boothie.app"
SUPPORT_PASSWORD="BoothieSupport2026!"

# Razorpay (USD Checkout + Webhooks)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional Email (Resend or SMTP webhook)
RESEND_API_KEY=""
EMAIL_FROM="Boothie Studio <receipts@boothie.app>"

